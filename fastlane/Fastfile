default_platform(:android)

# Play Store credentials are passed as raw JSON (PLAY_STORE_JSON_KEY) by CI,
# so they're never written to disk.
def play_store_json_key
  ENV.fetch("PLAY_STORE_JSON_KEY")
end

# Fastfile code runs from ./fastlane while actions run from the project root,
# so resolve the IPA to an absolute path.
def built_ipa_path
  Dir[File.expand_path("../build/ios/ipa/*.ipa", __dir__)].first ||
    UI.user_error!("No IPA found in build/ios/ipa")
end

# ───────────────────────────────────────────────────────────────────────────
# ANDROID LANES
# ───────────────────────────────────────────────────────────────────────────
platform :android do
  desc "Distribute a build via Firebase App Distribution"
  desc "Env: FIREBASE_APP_ID, FIREBASE_GROUPS, RELEASE_NOTES, ARTIFACT_PATH"
  lane :deploy_firebase do
    firebase_app_distribution(
      app: ENV.fetch("FIREBASE_APP_ID"),
      release_notes: ENV.fetch("RELEASE_NOTES", "Automated build via GitHub Actions"),
      groups: ENV.fetch("FIREBASE_GROUPS", "dev-testers"),
      android_artifact_type: "AAB",
      android_artifact_path: ENV.fetch(
        "ARTIFACT_PATH",
        "build/app/outputs/bundle/devRelease/app-dev-release.aab"
      )
    )
  end

  desc "Deploy Dev Build to Google Play Internal Testing track"
  lane :deploy_playstore_internal do
    upload_to_play_store(
      json_key_data: play_store_json_key,
      track: 'internal',
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      aab: "build/app/outputs/bundle/devRelease/app-dev-release.aab"
    )
  end

  desc "Deploy Production Build to Google Play Store Internal Track"
  lane :deploy_prod do
    upload_to_play_store(
      json_key_data: play_store_json_key,
      track: 'internal',
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      aab: "build/app/outputs/bundle/prodRelease/app-prod-release.aab"
    )
  end
end

# ───────────────────────────────────────────────────────────────────────────
# iOS LANES
# ───────────────────────────────────────────────────────────────────────────
platform :ios do
  desc "Sync Development Certificates and Profiles"
  lane :sync_dev_certs do
    setup_ci_api_key # Authenticates via App Store Connect API keys passed from CI
    match(type: "development", readonly: is_ci)
  end

  desc "Sync Production App Store Certificates"
  lane :sync_prod_certs do
    setup_ci_api_key
    match(type: "appstore", readonly: is_ci)
  end

  desc "Distribute a build via Firebase App Distribution"
  desc "Env: FIREBASE_APP_ID, FIREBASE_GROUPS, RELEASE_NOTES"
  lane :deploy_firebase do
    firebase_app_distribution(
      app: ENV.fetch("FIREBASE_APP_ID"),
      release_notes: ENV.fetch("RELEASE_NOTES", "Automated build via GitHub Actions"),
      groups: ENV.fetch("FIREBASE_GROUPS", "dev-testers"),
      ipa_path: built_ipa_path
    )
  end

  desc "Upload Production Build to TestFlight"
  lane :deploy_prod do
    setup_ci_api_key
    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      skip_submission: true,
      ipa: built_ipa_path
    )
  end
end

# Helper macro to build App Store Connect API context from environment variables
def setup_ci_api_key
  app_store_connect_api_key(
    key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
    issuer_id: ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
    key_content: ENV["APP_STORE_CONNECT_API_KEY_BASE64"],
    is_key_content_base64: true
  )
end
